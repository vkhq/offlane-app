{
  "name": "offlane",
  "productName": "Offlane",
  "version": "1.0.0",
  "private": true,
  "description": "Offlane",
  "keywords": [],
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Vikash Gupta",
    "email": "5319600+vkg92@users.noreply.github.com"
  },
  "main": ".webpack/main/index.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "secrets": "gitleaks dir . --redact --no-banner --verbose",
    "secrets:history": "gitleaks git . --redact --no-banner --verbose",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "publish-toolkits": "node scripts/publish-toolkits.mjs",
    "build:ffmpeg-mac": "scripts/build-ffmpeg-lgpl-mac.sh",
    "test:integration": "tsx src/tests/integration.ts",
    "test:e2e": "node src/tests/e2e/tabs.mjs",
    "test:download": "node src/tests/e2e/download.mjs",
    "test:download:online": "node src/tests/e2e/download.mjs --online",
    "new-tool": "node scripts/new-tool.mjs",
    "banners": "node scripts/bake-banners.mjs",
    "icons": "node scripts/make-icons.mjs",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-webpack": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "44.7.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.87.0",
    "postcss": "^8.5.29",
    "postcss-loader": "^8.2.1",
    "style-loader": "^3.3.4",
    "tailwindcss": "^4.3.3",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "electron-squirrel-startup": "^1.0.1",
    "extract-zip": "^2.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  }
}
